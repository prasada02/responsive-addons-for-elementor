{
  "name": "responsive-addons-for-elementor",
  "version": "2.1.1",
  "description": "Responsive Addons for Elementor plugin adds Elementor widgets and seamlessly integrates with any Elementor Package (Free, Pro). It is compatible with all popular WordPress themes.",
  "main": "index.js",
  "scripts": {
    "build": "wp-scripts build",
    "start": "wp-scripts start",
    "dashboard-start": "wp-scripts start ./admin/dashboard/src/index.js --output-path=admin/js/dashboard",
    "dashboard-build": "wp-scripts build ./admin/dashboard/src/index.js --output-path=admin/js/dashboard",
    "dashboard-css-start": "npx @tailwindcss/cli -i ./admin/dashboard/src/input.css -o ./admin/css/rael-dashboard.css --watch",
    "dashboard-css-build": "npx @tailwindcss/cli -i ./admin/dashboard/src/input.css -o ./admin/css/rael-dashboard.css"
  },
  "devDependencies": {
    "@wordpress/scripts": "^31.4.0"
  },
  "dependencies": {
    "@tailwindcss/cli": "^4.1.18",
    "react-router-dom": "^7.13.0",
    "tailwindcss": "^4.1.18",
    "tippy.js": "^6.2.7"
  }
}
